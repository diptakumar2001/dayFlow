{
  "appId": "io.github.diptakumar2001.dayflow",
  "appName": "DayFlow",
  "webDir": "www",
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_dayflow",
      "iconColor": "#4cc2a6"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#070b18",
      "showSpinner": false
    }
  }
}
